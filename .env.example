# Copia este archivo como .env.development o .env.production

# URL del backend real (cuando esté disponible)
VITE_API_BASE_URL=http://localhost:8000/api

# Usar MSW mocks (true en desarrollo, false en producción con backend real)
VITE_USE_MOCKS=true

# Nombre de la aplicación (white-label configurable)
VITE_APP_NAME=Lyberate Business Platform

# Modo de datos: 'local' = LocalStorage/MSW, 'api' = Backend real
VITE_DATA_MODE=local
